generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/pedidos_fruta_verdura/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  pedidos       Pedido[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Producto {
  id             Int              @id @default(autoincrement())
  nombre         String
  categoria      String
  unidad         String
  enTemporada    Boolean          @default(true)
  activo         Boolean          @default(true)
  notas          String?          @db.Text
  ordenSeccion   Int              @default(999)
  mesInicioTemp  Int?             // Mes inicio temporada (1-12)
  mesFinTemp     Int?             // Mes fin temporada (1-12)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  detalles       DetallePedido[]
  historicos     HistoricoPedido[]

  @@unique([nombre, categoria])
  @@index([categoria])
  @@index([activo])
}

model Pedido {
  id              Int             @id @default(autoincrement())
  fechaPedido     DateTime        @default(now())
  fechaEntrega    DateTime?
  tipoPedido      String?
  estado          String          @default("borrador")
  creadoPor       String
  notas           String?         @db.Text
  extrasAlbaran   Json?           // Extras y no registrados detectados al recibir
  user            User            @relation(fields: [creadoPor], references: [id])
  detalles        DetallePedido[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([estado])
  @@index([fechaPedido])
  @@index([creadoPor])
}

model DetallePedido {
  id                Int      @id @default(autoincrement())
  pedidoId          Int
  productoId        Int
  cantidadSolicitada Float
  cantidadRecibida  Float?
  merma             Float?   // Cantidad desperdiciada/no utilizada
  comentario        String?  @db.Text
  pedido            Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto          Producto @relation(fields: [productoId], references: [id])

  @@unique([pedidoId, productoId])
  @@index([pedidoId])
  @@index([productoId])
}

model HistoricoPedido {
  id         Int      @id @default(autoincrement())
  productoId Int
  fecha      DateTime
  cantidad   Float
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([productoId, fecha])
  @@index([productoId])
  @@index([fecha])
}

model ReglaIA {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String   @db.Text
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PreguntaIA {
  id          Int      @id @default(autoincrement())
  clave       String   @unique   // identificador: ensaladas, fruta_postre, etc.
  pregunta    String   @db.Text
  placeholder String?  @db.Text
  icono       String   @default("help")
  siempre     Boolean  @default(false) // aparece siempre sin importar el día
  diasSemana  String?  // "1,3,5" o null=siempre (se combina con campo siempre)
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConfiguracionTeams {
  id         Int      @id @default(autoincrement())
  webhookUrl String   @db.Text
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
