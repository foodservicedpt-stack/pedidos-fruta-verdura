# ==========================================================
# Variables de entorno de la aplicación "Pedidos Fruta y Verdura"
# Copia este archivo como .env y rellena los valores.
# NUNCA subas el archivo `.env` real a GitHub (ya está en .gitignore).
# ==========================================================

# --- Base de datos PostgreSQL ---
# Cadena de conexión a tu base de datos.
# Ejemplo local: postgresql://usuario:password@localhost:5432/pedidos
# (o una instancia en la nube: Neon, Supabase, Railway…)
DATABASE_URL=

# --- Autenticación (NextAuth) ---
# Genera un secreto aleatorio, por ejemplo con: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL pública donde se sirve la app (en local: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# --- OCR de albaranes: Google Gemini ---
# Clave desde https://aistudio.google.com (empieza por AIza…)
GEMINI_API_KEY=
# (Opcional) Modelo de Gemini. Por defecto: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# --- (Opcional) Exportación a PDF ---
# La app usa un servicio externo de conversión HTML->PDF (Abacus).
# Sin esta clave, la exportación a PDF devolverá un error claro.
# Si prefieres PDF autónomo, sustituye el generador (ej. Puppeteer/Playwright).
# ABACUSAI_API_KEY=
